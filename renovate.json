{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "reviewers": [
    "h3nc4"
  ],
  "assignAutomerge": true,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "gitIgnoredAuthors": [
    "41898282+github-actions[bot]@users.noreply.github.com"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "addLabels": ["automerge"],
    "automerge": true,
    "schedule": [
      "before 4am"
    ]
  },
  "packageRules": [
    {
      "groupName": "go-deps",
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "addLabels": ["automerge"],
      "automerge": true
    },
    {
      "description": "Group SonarQube server and scanner updates",
      "groupName": "sonarqube",
      "matchPackageNames": [
        "sonarqube",
        "sonarsource/sonar-scanner-cli"
      ]
    },
    {
      "description": "Disable unwanted pinning for SonarQube images",
      "matchPackageNames": [
        "sonarqube",
        "sonarsource/sonar-scanner-cli"
      ],
      "pinDigests": false
    },
    {
      "description": "Auto-merge all minor, patch, pin, and digest updates",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "addLabels": ["automerge"],
      "automerge": true,
      "platformAutomerge": true
    }
  ]
}
